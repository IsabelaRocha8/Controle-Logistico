# Configuração do Banco de Dados
# Use uma das seguintes variáveis de ambiente para conectar ao PostgreSQL

# Opção 1: DATABASE_URL (padrão)
DATABASE_URL=postgresql://user:password@localhost:5432/nil_logistica

# Opção 2: POSTGRES_URL (Neon)
# POSTGRES_URL=postgresql://user:password@host/database

# Opção 3: POSTGRES_URL_NON_POOLING (Neon sem pooling)
# POSTGRES_URL_NON_POOLING=postgresql://user:password@host/database

# Opção 4: POSTGRES_PRISMA_URL (Prisma)
# POSTGRES_PRISMA_URL=postgresql://user:password@host/database

# Opção 5: NEON_DATABASE_URL (Neon específico)
# NEON_DATABASE_URL=postgresql://user:password@host/database

# Porta do servidor
PORT=3000

# Secret para JWT
# Se não configurado, usa valor padrão de desenvolvimento
# Altere para um valor seguro em produção
AUTH_SECRET=sua-chave-secreta-super-segura-aqui
JWT_SECRET=sua-chave-jwt-super-segura-aqui
